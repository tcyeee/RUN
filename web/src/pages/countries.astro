---
import Layout from "../layouts/Layout.astro";
import CountryCompare from "../components/CountryCompare";
---

<Layout title="国家对比 — RUN · 润">
  <div class="mx-auto mb-10 max-w-2xl text-center">
    <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      国家对比
    </h1>
    <p class="mt-4 text-lg text-ink-soft">
      点列名排序，勾选国家做并排对比。数据来自 Numbeo / Tax Foundation / Henley
      Passport Index（2026）。
    </p>
  </div>
  <CountryCompare client:load />
</Layout>
