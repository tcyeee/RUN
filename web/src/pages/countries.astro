---
import Layout from "../layouts/Layout.astro";
import CountryCompare from "../components/CountryCompare";
---

<Layout title="国家对比 — RUN · 润">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800">📊 国家对比</h1>
    <p class="mt-2 text-slate-500">
      点列名排序，勾选国家做并排对比。数据来自 Numbeo / Tax Foundation / Henley Passport Index（2026）。
    </p>
  </div>
  <CountryCompare client:load />
</Layout>
