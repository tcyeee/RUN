---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "RUN · 润 — 海外移居手册" } = Astro.props;
const path = Astro.url.pathname;

const navItems = [
  { href: "/", label: "选路向导" },
  { href: "/routes", label: "路线库" },
  { href: "/countries", label: "国家对比" },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <script data-goatcounter="https://run.viii.me/count" async src="/count.js"></script>
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-ink antialiased">
    <header
      class="sticky top-0 z-50 border-b border-black/5 bg-white/70 backdrop-blur-xl backdrop-saturate-150"
    >
      <nav class="mx-auto flex max-w-5xl items-center gap-8 px-6 py-4">
        <a href="/" class="flex items-center gap-2">
          <span
            class="flex h-7 items-center rounded-lg bg-gradient-to-br from-brand to-brand-dark px-2 text-[11px] font-bold tracking-wide text-white shadow-sm"
          >
            RUN
          </span>
          <span class="text-[15px] font-semibold tracking-tight text-ink">润</span>
        </a>
        <div class="flex items-center gap-6">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={`text-[13px] font-medium transition-colors ${
                  path === item.href
                    ? "text-ink"
                    : "text-ink-soft hover:text-ink"
                }`}
              >
                {item.label}
              </a>
            ))
          }
        </div>
        <a
          href="https://github.com/tcyeee/RUN"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="ml-auto flex items-center text-ink-soft transition-colors hover:text-ink"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.38 7.86 10.9.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.7 1.25 3.36.96.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.07.78 2.16 0 1.56-.01 2.82-.01 3.2 0 .3.21.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
            ></path>
          </svg>
        </a>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-12 sm:py-16">
      <slot />
    </main>
    <footer class="border-t border-black/5">
      <div class="mx-auto max-w-5xl px-6 py-8 text-center text-[12px] text-ink-soft">
        RUN · 润 — 海外移居手册，数据仅供参考，请以官方信息为准。
      </div>
    </footer>
  </body>
</html>
